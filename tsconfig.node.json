{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "src/plugins/**/types.ts",
    "src/plugins/credentials/csv.ts",
    "src/plugins/credentials/strength.ts",
    "src/plugins/credentials/offline-queue.ts",
    "src/core/clip-utils.ts",
    "src/plugins/captures/naming.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "paths": {}
  }
}
